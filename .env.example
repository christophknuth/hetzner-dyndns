# Copy to .env next to compose.yaml, or set these as stack environment
# variables in Dockhand.

# Absolute path ON THE DOCKER HOST to your filled-in configuration.
# Create it once from hetzner_dyndns.config.php.dist; it is gitignored because
# it contains the Hetzner API token and the DynDNS password.
DYNDNS_CONFIG=/var/docker/hetzner-dyndns/hetzner_dyndns.config.php

# The hostname you want to update with Hetzner's DynDNS service.
# This is the hostname you will use to access the DynDNS endpoint, e.g. "your-dyndns-hostname.example"
DYNDNS_HOST=your-dyndns-hostname.example.com